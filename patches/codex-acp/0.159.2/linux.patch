+    /// Replay projected items, including history outside the current model context window.
+    fn handle_replay_stored_items(&self, items: Vec<StoredThreadItem>) -> Result<(), Error> {
+        for item in items {
+            match &item {
+                StoredThreadItem::UserMessage { content, .. } => {
+                    let text = content
+                        .iter()
+                        .filter_map(|input| match input {
+                            codex_app_server_protocol::UserInput::Text { text, .. } => {
+                                Some(text.as_str())
+                            }
+                            _ => None,
+                        })
+                        .join("\n");
+                    self.client.send_user_message(text);
+                    continue;
+                }
+                StoredThreadItem::AgentMessage { text, .. } => {
+                    self.client.send_agent_text(text.clone());
+                    continue;
+                }
+                StoredThreadItem::Reasoning {
+                    summary, content, ..
+                } => {
+                    for text in summary.iter().chain(content) {
+                        self.client.send_agent_thought(text.clone());
+                    }
+                    continue;
+                }
+                StoredThreadItem::FunctionCallOutput { id, output, .. } => {
+                    self.client
+                        .send_tool_call_completed(id.clone(), Some(json!(output)));
+                    continue;
+                }
+                StoredThreadItem::HookPrompt { .. }
+                | StoredThreadItem::Plan { .. }
+                | StoredThreadItem::SubAgentActivity { .. }
+                | StoredThreadItem::EnteredReviewMode { .. }
+                | StoredThreadItem::ExitedReviewMode { .. }
+                | StoredThreadItem::ContextCompaction { .. } => continue,
+                _ => {}
+            }
+            let (title, kind) = match &item {
+                StoredThreadItem::CommandExecution { command, .. } => {
+                    (command.clone(), ToolKind::Execute)
+                }
+                StoredThreadItem::FileChange { .. } => ("Apply patch".to_string(), ToolKind::Edit),
+                StoredThreadItem::McpToolCall { server, tool, .. } => {
+                    (format!("{server}/{tool}"), ToolKind::Other)
+                }
+                StoredThreadItem::DynamicToolCall { tool, .. } => (tool.clone(), ToolKind::Other),
+                StoredThreadItem::CollabAgentToolCall { tool, .. } => {
+                    (format!("{tool:?}"), ToolKind::Other)
+                }
+                StoredThreadItem::WebSearch(..) => ("Web Search".to_string(), ToolKind::Search),
+                StoredThreadItem::ImageView { .. } => ("View image".to_string(), ToolKind::Read),
+                StoredThreadItem::ImageGeneration(..) => {
+                    ("Image generation".to_string(), ToolKind::Other)
+                }
+                StoredThreadItem::Sleep(..) => ("Sleep".to_string(), ToolKind::Other),
+                _ => continue,
+            };
+            let snapshot = serde_json::to_value(&item).map_err(Error::into_internal_error)?;
+            let status = match snapshot.get("status").and_then(serde_json::Value::as_str) {
+                Some("inProgress" | "in_progress") => ToolCallStatus::InProgress,
+                Some("failed" | "declined" | "cancelled" | "incomplete" | "interrupted") => {
+                    ToolCallStatus::Failed
+                }
+                _ => ToolCallStatus::Completed,
+            };
+            self.client.send_tool_call(
+                ToolCall::new(item.id().to_string(), title)
+                    .kind(kind)
+                    .status(status)
+                    .raw_output(snapshot),
+            );
         }
         Ok(())
     }
